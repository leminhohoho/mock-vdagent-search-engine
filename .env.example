# Values in this file override shell environment variables. Containers have no .env and read
# the environment only.

# Postgres holding the corpus (schema `mockserp`). For Supabase use the session pooler string:
# Dashboard -> Connect -> Session pooler. Required by `ingest` and `serve`; keep it server-side.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Upper bound on pooled connections per server process.
DB_POOL_SIZE=5

# OpenAI-compatible embeddings endpoint.
# EMBEDDING_* wins; OPENAI_BASE_URL / OPENAI_API_KEY are used as fallbacks.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128

# Markdown pages read by `mockserp ingest`.
CORPUS_DIR=data/corpus

# If set, clients must send `Authorization: Bearer <MOCK_API_KEY>`; unset accepts any/no key.
# Required whenever HOST is not loopback (127.0.0.1, ::1, localhost).
# MOCK_API_KEY=tvly-mock

# Pin "now" for time_range filters (ISO 8601), for reproducible demos/tests.
# MOCK_NOW=2026-10-01T00:00:00Z

HOST=127.0.0.1
PORT=8000
